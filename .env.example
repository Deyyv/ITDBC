# Copia este archivo a `.env` para desarrollo local (opcional).
# En producción, define estas variables en Vercel (Project > Settings > Environment Variables).

# ===== Sincronización con Upstash Redis (solo en producción) =====
# Poner en "1" activa el POST /api/sync desde el frontend al registrar/canjear.
# Sin esto, la app funciona 100% offline con localStorage (como hasta ahora).
VITE_API_SYNC=1

# URL pública final del despliegue. Se usa para construir el QR de la página pública.
# Ej: https://reciclapoint.vercel.app  (sin barra final, sin ruta)
VITE_APP_URL=https://tu-dominio.vercel.app

# ===== Credenciales Upstash Redis (las inyecta la integración Vercel) =====
# No las pongas en git. En Vercel las agrega la integración de Upstash automáticamente.
# Para probar con `vercel dev` escribe las siguientes (del dashboard de Upstash):
# UPSTASH_REDIS_REST_URL=rediss://...
# UPSTASH_REDIS_REST_TOKEN=...